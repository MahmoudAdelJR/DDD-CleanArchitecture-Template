{
  "name": "ddd-clean-architecture-template",
  "version": "1.2.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --browsers=ChromeHeadless --code-coverage",
    "test:generator": "node --test scripts/generate.integration.test.mjs",
    "test:init": "node --test scripts/init-project.integration.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p e2e/tsconfig.json",
    "format": "prettier --write \"./{src,e2e,deploy,docs,scripts,.github}/**/*.{ts,mjs,json,html,scss,md,yml,yaml}\" \"*.{ts,mjs,json,md}\"",
    "format:check": "prettier --check \"./{src,e2e,deploy,docs,scripts,.github}/**/*.{ts,mjs,json,html,scss,md,yml,yaml}\" \"*.{ts,mjs,json,md}\"",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "audit:gate": "node scripts/audit-allowlist.mjs",
    "gen:feature": "node scripts/generate.mjs feature",
    "gen:page": "node scripts/generate.mjs page",
    "check:architecture": "node scripts/check-architecture.mjs",
    "init:project": "node scripts/init-project.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.34",
    "@playwright/test": "^1.64.1",
    "@types/jasmine": "~5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "jasmine-core": "~5.9.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2"
  }
}
